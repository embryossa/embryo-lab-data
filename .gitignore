data/raw/
data/inbox/
data/miri_logs/
data/processed/
!data/raw/.gitkeep
!data/inbox/.gitkeep
!data/miri_logs/.gitkeep
!data/processed/.gitkeep
crosswalk.*
dupe_check.csv

# машинно-зависимые абсолютные пути (Desktop-папки DT/TabPFN/KAN), общие для всех клиник:
config/machine.local.yaml
# клиничные секреты/флаги (Airtable/PGT токены и т.п.):
config/settings.local.yaml
config/clinics/*/settings.local.yaml

# Teable API-токены (облако + self-hosted):
teable/teable_config*.json
teable/self-hosted/.env
teable/sync_log.txt
teable/sync_done.flag

# Python / окружение
venv/
.venv/
__pycache__/
*.pyc
.env

# Тесты и покрытие
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# внешние выходы/модели
*.joblib
*.pyd

# машинные пути исследовательских скриптов reports/ (шаблон — *.example):
config/research_paths.local.json

# reports/: публикуются только код, агрегированные таблицы, рисунки и тексты.
# Построчные данные циклов (прогнозы, payload, исходы, per-cycle CSV для
# рисунков), логи прогонов и промежуточные pickle остаются локально.
reports/**/logs/
reports/**/shards/
reports/**/work/
reports/**/*.log
reports/**/*.pkl
reports/**/run_log.txt
reports/**/api_payload.json
reports/**/outcomes.csv
reports/**/imputation_flags.csv
reports/**/dt_full_*.csv
reports/**/dt71_predictions.csv
reports/**/test_predictions.csv
reports/**/*_predictions.csv
reports/**/fig_*_minimal.csv
reports/**/seen_overlap.csv

# одноразовые локальные выгрузки/бэкапы
.claude/*.doctor-bak
batch*_extract.py
