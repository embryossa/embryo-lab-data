# config/machine.local.yaml.example — ШАБЛОН машинно-зависимых путей к внешним
# инструментам (IVF Digital Twin, TabPFN, DNN verifier, TabPFN-3 regression).
#
# Скопируйте в config/machine.local.yaml (в .gitignore, не коммитится) и подставьте
# реальные пути этого ПК. Это ЕДИНСТВЕННЫЙ файл, который нужно поменять при переносе
# всего проекта (embryo-lab-data + внешние DT/TabPFN/KAN-проекты) на новую машину —
# он подмешивается ОДИНАКОВО в обе клиники (config/settings.yaml и
# config/clinics/*/settings.yaml), так что путь к, например, сертификату службы DT
# указывается один раз, а не отдельно для каждой клиники.
#
# config/settings.yaml и config/clinics/*/settings.yaml (версионированные, в git)
# держат только переносимую логику/структуру и НЕ содержат абсолютных путей —
# их редактировать при переезде не нужно. Клиничный settings.local.yaml остаётся
# только для действительно клиничных секретов/флагов (Airtable-токен, pgt.enabled,
# google_drive_folder_id) — см. config/settings.local.yaml.example и
# config/clinics/fertimed/settings.local.yaml.example.
#
# После заполнения проверьте обе клиники разом:
#   python scripts\check_setup.py --all-clinics

external_tools:
  digital_twin:
    # IVF Digital Twin 7.1 через локальный REST API — единственный вход DT для всех
    # клиник (README, раздел «Digital Twin 7.1 через API»; батч 7.0 снят 2026-09-13).
    # В 7.1: Настройка → Подключение МИС / ЛИС → тип «Аналитика» → Создать ключ; затем
    # python -m embryo.dt_api store-key и python -m embryo.dt_api health (PYTHONPATH=src).
    # Политика пакета (n_sim, timepoints, impute, fallback) — в версионированных
    # settings.yaml; здесь только машинное.
    api:
      ca_cert: "C:/ProgramData/IVF Clinic Integration 7.1/server.crt"
      # url: "https://127.0.0.1:8843/api/v1"     # если служба слушает другой адрес
      # key_file: "C:/path/to/dt-api.key"         # по умолчанию %LOCALAPPDATA%/embryo-lab-data/dt-api.key
      # sperm_source_map: {SMF: testicular_OA}   # токен выгрузки -> категория 7.1

  tabpfn:
    # Папка headless-батч-адаптера TabPFN (run_tabpfn_batch.py/.bat) — см.
    # docs/TABPFN_INSTALL.md, что туда скопировать при первой установке.
    project_dir: "C:/path/to/TABPFN"
    results_dir: "C:/path/to/TABPFN/tabpfn_logs"
    # run_cmd: '.\run_tabpfn_batch.bat --input {input} --output {output} --run-id {run_id}'

  dnn_verifier:
    # ОПЦИОНАЛЬНАЯ независимая DNN (Evo_calculations.py) — своё окружение/torch.
    project_dir: "C:/path/to/PycharmProject"
    model_path: "C:/path/to/PycharmProject/KAN/saved_model/my_best_model"
    scaler_path: "C:/path/to/PycharmProject/KAN/saved_model/training_scaler.joblib"
    # Только путь к python.exe нужного venv меняется между машинами;
    # {repo_root} подставляется автоматически (корень ЭТОГО репозитория) —
    # его в run_cmd прописывать не нужно.
    run_cmd: '"C:/path/to/venv/Scripts/python.exe" "{repo_root}/external/dnn/Evo_calculations.py" --input {input} --model {model} --scaler {scaler} --output {output}'

  tabpfn_regression:
    # TabPFN-3: количественный прогноз стадий воронки (MII/2PN/Bl/Good Bl/Frozen).
    project_dir: "C:/path/to/PycharmProject/tabpfn"
    run_cmd: '"C:/path/to/PycharmProject/tabpfn/.venv/Scripts/python.exe" tabpfn3_ivf_regression_report_CPU_16K.py --opu-path {input} --output-csv {output}'
