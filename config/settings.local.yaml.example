# Скопируйте в config/settings.local.yaml и подставьте под свой ПК (в .gitignore).
#
# Абсолютные пути к DT/TabPFN/DNN/TabPFN-3 (project_dir/results_dir/model_path/
# scaler_path/run_cmd) сюда НЕ ходят — они в config/machine.local.yaml (см.
# config/machine.local.yaml.example), общем для всех клиник. Здесь только то,
# что специфично именно для клиники A: DNN-флаг, MIRI-источник, Airtable-токен.
external_tools:
  dnn_verifier:
    enabled: true

# Если Google Drive for desktop синхронизирует папку Miri локально, укажите её корень.
miri_logs:
  base_dir: "G:/My Drive/Miri"

# Personal Access Token из airtable.com/create/tokens (scopes: data.records:read,
# schema.bases:read; access -> только база лотов лаборатории). Без него consumable_lots
# остаётся enabled: false и форензик по лотам просто не запускается.
consumable_lots:
  enabled: true
  airtable:
    base_id: "appXXXXXXXXXXXXXX"
    items_table_id: "tblXXXXXXXXXXXXXX"     # расходные материалы
    changes_table_id: "tblXXXXXXXXXXXXXX"   # Barcode Changes History
    token: "patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
