# Скопируйте в config/clinics/fertimed/settings.local.yaml (в .gitignore).
# DT/TabPFN/DNN/TabPFN-3 regression — та же среда, что у клиники A (владелец
# подтвердил 2026-07-18); их пути настраиваются ОДИН раз для обеих клиник в
# config/machine.local.yaml (см. config/machine.local.yaml.example) — здесь
# обычно нечего переопределять, кроме следующего, когда будет готово:

pgt:
  enabled: true   # включить, когда парсер под my.f-genetics.com будет готов (см. docs/FERTIMED.md)

consumable_lots:
  enabled: false   # у Fertimed нет выгрузки лотов расходников — оставить выключенным
